# SupportFlow configuration — copy to .env and fill in values.
# .env must never be committed.

# --- App ---
SUPPORTFLOW_APP_ENV=development
SUPPORTFLOW_LOG_LEVEL=INFO

# --- DeepSeek (optional on Day 1 — leave empty to run tests locally) ---
SUPPORTFLOW_DEEPSEEK_API_KEY=
SUPPORTFLOW_DEEPSEEK_MODEL=deepseek-chat
SUPPORTFLOW_DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Persistence (PostgreSQL via docker compose; sqlite stays the
# --- app default only until SUPPORTFLOW_DATABASE_URL is set) ---
# Development database started by `docker compose up -d` (see compose.yaml).
# These POSTGRES_* values are placeholders for local development only.
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supportflow
SUPPORTFLOW_DATABASE_URL=postgresql+psycopg://supportflow:change-me@127.0.0.1:5432/supportflow
# Separate database used by integration tests that need a live server.
SUPPORTFLOW_TEST_DATABASE_URL=postgresql+psycopg://supportflow:change-me@127.0.0.1:5432/supportflow_test

# --- Agent guardrails ---
SUPPORTFLOW_MAX_AGENT_ITERATIONS=10
SUPPORTFLOW_TOOL_TIMEOUT_SECONDS=30
